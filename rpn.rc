/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

RPN_ACCELERATORS ACCELERATORS
BEGIN
    "C", IDM_COPY_X, VIRTKEY, CONTROL
    "V", IDM_PASTE_X, VIRTKEY, CONTROL
END

RPN_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&Edit"
    BEGIN
        POPUP "&Copy"
        BEGIN
            MENUITEM "Copy from &X\tCtrl+C",        IDM_COPY_X
            MENUITEM "Copy from &Y",                IDM_COPY_Y
            MENUITEM "Copy from &Z",                IDM_COPY_Z
            MENUITEM "Copy from &T",                IDM_COPY_T
        END
        POPUP "&Paste"
        BEGIN
            MENUITEM "Paste to &X\tCtrl+V",         IDM_PASTE_X
            MENUITEM "Paste to &Y",                 IDM_PASTE_Y
            MENUITEM "Paste to &Z",                 IDM_PASTE_Z
            MENUITEM "Paste to &T",                 IDM_PASTE_T
        END
    END
    POPUP "&Base"
    BEGIN
        MENUITEM "&Binary",                     IDM_BINARY
        MENUITEM "&Octal",                      IDM_OCTAL
        MENUITEM "&Decimal",                    IDM_DECIMAL
        MENUITEM "&Hexadecimal",                IDM_HEXADECIMAL
        MENUITEM SEPARATOR
        MENUITEM "&Floating Point",             IDM_FLOAT
    END
    POPUP "&Word Size"
    BEGIN
        MENUITEM "&8 bits",                     IDM_WORD_SIZE_8
        MENUITEM "&16 bits",                    IDM_WORD_SIZE_16
        MENUITEM "&32 bits",                    IDM_WORD_SIZE_32
        MENUITEM "&64 bits",                    IDM_WORD_SIZE_64
    END
    POPUP "&Integer"
    BEGIN
        MENUITEM "&Unsigned",                   IDM_INTEGER_TYPE_UNSIGNED
        MENUITEM "Signed, &1's Complement",     IDM_INTEGER_TYPE_1S, GRAYED
        MENUITEM "Signed, &2's Complenent",     IDM_INTEGER_TYPE_2S
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Keypad\tUp/Down",            IDM_VIEW_KEYPAD, CHECKED
    END
    POPUP "\a&Help"
    BEGIN
        MENUITEM "&Help Keys Mode",             IDM_HELP_HELP_KEYS
        MENUITEM "&About...",                   IDM_HELP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_DIGIT               "Digit\n\rOnly those digit keys valid in the\n\rcurrent base are enabled.\n\rThese buttons are assigned to their\n\rrespective keyboard keys."
    IDS_BACKSPACE_KEY       "Backup one digit.\n\rAssigned to the 'Backspace' key."
    IDS_SWAP_KEY            "Swap bottom two levels of stack.\n\rAssigned to the 'Tab' key."
    IDS_ENTER_KEY           "Enter current value to bottom of stack and push stack up one.\n\rAssigned to 'Enter' key."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_MOD_KEY             "Modulus operator: X = (Y % X).\n\rAssigned to the '%' key."
    IDS_AND_KEY             "Logical AND operator: X = (Y AND X).\n\rAssigned to the '&' key."
    IDS_MULT_KEY            "Multiplication operator: X = (Y * X).\n\rAssigned to the '*' key."
    IDS_PLUS_KEY            "Addition operator: X = (Y + X).\n\rAssigned to the '+' key.\n\rUnary Addition assigned to the ']' key."
    IDS_UNARY_LEFT_SHIFT    "Left Shift by 1: X = (X << 1)\n\rAssigned to the ',' key"
    IDS_MINUS_KEY           "Subtraction operator: X = (Y -- X).\n\rAssigned to the '--' key.\n\rUnary Subtraction assigned to the '[' key."
    IDS_UNARY_RIGHT_SHIFT   "Right Shift by 1: X = (X >> 1)\n\rAssigned to the '.' key"
    IDS_DIV_KEY             "Division operator: X = (Y / X).\n\rAssigned to the '/' key."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_DECIMAL_KEY         "Decimal point\n\rAssigned to the '.' key"
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_OR_KEY              "Logical OR opeartor: X = (X OR Y).\n\rAssigned to the '|' key."
    IDS_NOT_KEY             "Logical NOT operator: X = (NOT X).\n\rAssigned to the '~' key."
    IDS_DELETE_KEY          "Clear X: Drop the bottom level of the stack.\n\rAssigned to the 'Delete' key."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_PI_KEY              "Pi\n\rConstant value of Pi\n\rAssigned to the 'P' key"
    IDS_SQRT_KEY            "Sqare root operator\n\rX = Sqrt(X)\n\rAssigned to the 'Q' key\n\rInverse:X = X squared"
    IDS_ROLL_DOWN_KEY       "Roll Down: Roll the stack down one level.\n\rAssigned to the 'R' key."
    IDS_NEGATE_KEY          "Change Sign operator: X = (--X).\n\rAssigned to the 'S' key."
    IDS_TAN_KEY             "Tangent operator\n\rX = tan(X)\n\rAssigned to the 'T' key\n\rInverse:X = atan(X)"
    IDS_UNARY_MINUS         "Unary Subtraction Operator: X = (X -- 1)\n\rAssigned to the '[' key"
    IDS_UNARY_PLUS          "Unary Addition Operator: X = (X + 1)\n\rAssigned to the ']' key"
    IDS_XOR_KEY             "Logical XOR operator: X = (Y XOR X).\n\rAssigned to the '^' key."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_LEFT_SHIFT_KEY      "Left Shift operator: X = (Y << X).\n\rShift operators ignore all but last 6 bits of X.\n\rAssigned to the '<' key.\n\rLeft Shift by 1 assigned to the ',' key."
    IDS_RIGHT_SHIFT_KEY     "Right Shift operator: X = (Y >> X).\n\rShift operators ignore all but last 6 bits of X.\n\rAssigned to the '>' key.\n\rRight Shift by 1 assigned to the '.' key."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_COS_KEY             "Cosine operator\n\rX = cos(X)\n\rAssigned to the 'C' key\n\rInverse:X = acos(X)"
    IDS_EEX_KEY             "Enter an exponent\n\rAssigned to the 'E' key"
    IDS_LOG_KEY             "Base 10 logarithm operator\n\rX = log(X)\n\rAssigned to the 'G' key\n\rInverse:X = 10 to the X'th power"
    IDS_SIN_KEY             "Sine operator\n\rX = sin(X)\n\rAssigned to the 'I' key\n\rInverse:X = asin(X)"
    IDS_KILO_KEY            "Kilo operator, X = (X * 1024).\n\rAssigned to the 'K' key."
    IDS_TOGGLE_BASE_KEY     "Last Base: Toggle between the last two used bases.\n\rAssigned to the 'L' key."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_BINARY              "Binary\n\rUse Base 2 for display\n\rand digit entry."
    IDS_OCTAL               "Octal\n\rUse Base 8 for display\n\rand digit entry."
    IDS_DECIMAL             "Decimal\n\rUse Base 10 for display\n\rand digit entry."
    IDS_HEXADECIMAL         "Hexadecimal\n\rUse base 16 for display\n\rand digit entry."
    IDS_FLOAT               "Toggle calculator to floating point mode"
    IDS_WORD_SIZE_8         "Use 8-bit words."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_WORD_SIZE_16        "Use 16-bit words."
    IDS_WORD_SIZE_32        "Use 32-bit words."
    IDS_WORD_SIZE_64        "Use 64-bit words."
    IDS_INTEGER_TYPE_UNSIGNED "Use Unsigned integer representation."
    IDS_INTEGER_TYPE_1S     "Use One's Complement integer representation.\n\r(Not yet implemented.)"
    IDS_INTEGER_TYPE_2S     "Use Two's Complement integer representation."
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_ONE_OVER_KEY        "1/x operator\n\rX = 1/X\n\rAssigned to the '%' key"
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_INVERSE_KEY         "Inverse toggle\n\rInverse of the next operation\n\rie, Inverse sin = asin\n\rAssigned to the ESC key"
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_YTOX_KEY            "Power operator\n\rX = Y to the X'th power\n\rAssigned to the '^' key\n\rInverse:X = X'th root of Y"
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_LN_KEY              "Natural logarithm operator\n\rX = ln(X)\n\rAssigned to the 'N' key\n\rInverse:X = e raised to the X'th power"
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_TRIG_DEGREE         "Use degrees for trigonometry calculations"
    IDS_TRIG_RADIAN         "Use radians for trigonometry calculations"
    IDS_TRIG_GRAD           "Use grads for trigonometry calculations"
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_COPY_X              "Copy the contents of X to the clipboard"
    IDS_COPY_Y              "Copy the contents of Y to the clipboard"
    IDS_COPY_Z              "Copy the contents of Z to the clipboard"
    IDS_COPY_T              "Copy the contents of T to the clipboard"
    IDS_PASTE_X             "Paste the clipboard contents to X"
    IDS_PASTE_Y             "Paste the clipboard contents to Y"
END

STRINGTABLE DISCARDABLE 
BEGIN
    IDS_PASTE_Z             "Paste the clipboard contents to Z"
    IDS_PASTE_T             "Paste the clipboard contents to T"
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_VIEW_KEYPAD         "Show or hide the keypad.\n\rHide (roll up) with the 'Up' arrow key.\n\rShow (unroll) with the 'Down' arrow key."
END

